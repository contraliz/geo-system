# Required: API key for the upstream Anthropic-compatible service.
# For MiniMax, generate one at https://platform.minimaxi.com (China)
# or https://platform.minimax.io (international).
# For direct Anthropic, use a key from https://console.anthropic.com.
ANTHROPIC_API_KEY=

*** Required: upstream base URL. Pick the one that matches the region
# where your MiniMax / Anthropic account lives.
#
# MiniMax (China, the default below):  https://api.minimaxi.com/anthropic
# MiniMax (international):              https://api.minimax.io/anthropic
# Anthropic (direct):                  https://api.anthropic.com
#
# The status endpoint and the Settings → Live writing agent panel detect
# the provider by checking whether the URL contains "minimax".
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Optional proxy server settings (defaults shown).
# PROXY_PORT=8787
# PROXY_ALLOW_ORIGIN=http://127.0.0.1:5174