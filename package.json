{
  "name": "geo-operations-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently --kill-others-on-fail -n vite,proxy,publisher -c blue,magenta,green \"vite\" \"node --env-file-if-exists=.env server/proxy.mjs\" \"node --env-file-if-exists=.env publisher/server.mjs\"",
    "proxy": "node --env-file-if-exists=.env server/proxy.mjs",
    "publisher": "node --env-file-if-exists=.env publisher/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:smoke": "node tests/fixtures/make-png.cjs && playwright test",
    "test:smoke:install": "playwright install chromium",
    "test:unit": "node --test tests/publisher-vault.test.mjs tests/publisher-runtime.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "vite": "8.2.1",
    "puppeteer-core": "^24.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "^10.0.5",
    "typescript": "7.0.2"
  }
}
